# --- chain ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Only for `memory init --register` and `memory push`: the wallet that owns the
# identity name. A test wallet, never funded beyond gas. 0x prefix optional.
PRIVATE_KEY=

# --- storage ---
RECALL_STORAGE=pinata             # pinata | swarm
# Needed only to PUSH. Readers fetch through the gateway and need no Pinata
# account. The key must have pinFileToIPFS (or Admin) scope — a key with no
# scopes authenticates fine and then fails at pin time.
PINATA_JWT=
# Dedicated gateway host, e.g. my-gateway.mypinata.cloud. Never a public one.
PINATA_GATEWAY=

# --- swarm (optional, unexercised) ---
BEE_API_URL=http://localhost:1633
BEE_POSTAGE_BATCH_ID=

# --- local ---
# Repositories live under <dir>/repos/<namespace>.
RECALL_CACHE_DIR=~/.recall

# --- knowledge namespaces ---
# Which namespace the CLI and MCP server target when more than one exists locally.
KNOWLEDGE_NAMESPACE=cancer-research.eth

# Whose namespaces the connected-apps agent writes into: tools.<owner>,
# projects.<owner>. There is no default — starting without it fails loudly
# rather than writing your real activity somewhere you do not control.
CONNECT_OWNER=you.eth
# The name the MCP server signs contributions with — a label, not a memory. Default: "reader".
KNOWLEDGE_AGENT=
# Namespaces the explorer lists; local repositories are added automatically.
NEXT_PUBLIC_KNOWLEDGE_NAMESPACES=cancer-research.eth,treasury.eth,signals.treasury.eth,personal.eth,treasury.kestrel.eth,watch.kestrel.eth,portfolio.kestrel.eth,conventions.acme.eth
# Content key for PRIVATE namespaces only (public ones are plaintext on IPFS). Printed once by
# `knowledge init --private`; a reader on a fresh machine passes it via `knowledge init <name> --key`.
RECALL_CONTENT_KEY=

# --- extraction (optional) ---
# With a key, the agent reads your sources with a model instead of keyword rules:
# it recognises sites and projects nothing hardcoded knows about. Without one it
# falls back to the rules, and the UI says which path produced each claim.
# Any OpenAI-compatible endpoint works; OpenRouter is the default.
# Extraction defaults to FREE models — this is a small structured-output job on
# ~30 rows per poll, so paying for it would be silly. Free tiers rate-limit, so
# the client falls through a list of them and records which one answered.
OPENROUTER_API_KEY=
# Leave unset for the free default (qwen/qwen3.8-27b:free). Other free options:
#   google/gemma-4-31b-it:free · nvidia/nemotron-3.5-lightning:free · inclusionai/ling-3.0-flash-vl:free
KNOWLEDGE_MODEL=

# --- Hosted mode: let anyone connect their own accounts -----------------------
# Leave these unset to run locally, where the machine's own sources (browser,
# editor, shell, Claude Code) are read and CONNECT_OWNER says where claims go.
# Set them and the site switches to sign-in: each visitor connects their own
# accounts, and the local sources are hidden because they would read the server.

# Encrypts stored access tokens and signs session cookies. Required in hosted
# mode; there is deliberately no default. Generate with: openssl rand -hex 32
CONNECT_SECRET=

# Where the OAuth callback comes back to. Must match the app's registered URL.
CONNECT_BASE_URL=http://localhost:3000

# New users get <login>.<this>. Their claims are real and exportable from day
# one; the name is the host's until they register their own.

# GitHub: github.com/settings/developers -> New OAuth App
#   Homepage         http://localhost:3000
#   Callback URL     http://localhost:3000/api/auth/github/callback
# Free, instant, no review. Scopes requested: read:user, public_repo.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Linear: linear.app/settings/api -> OAuth applications -> Create new
#   Callback URL     http://localhost:3000/api/auth/linear/callback
# Free, instant, no review. Scope requested: read (Linear's only read scope).
# The reader keeps team and project names only — never issue titles or comments.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Google (Calendar + Gmail metadata): console.cloud.google.com
#   1. New project -> APIs & Services -> Library -> enable "Google Calendar API"
#      and "Gmail API"
#   2. OAuth consent screen -> External -> add yourself under "Test users"
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application
#      Authorised redirect URI: http://localhost:3000/api/auth/google/callback
# Test-user mode works immediately for up to 100 accounts, and refresh tokens
# expire every 7 days while the app is unverified. Publishing to everyone needs
# Google verification, and Calendar/Gmail are restricted scopes, which means a
# third-party CASA security assessment (roughly $15k-75k/yr).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scheduled passes. Without this the agent only runs while someone has the page
# open, so a hosted deployment's memory stops updating when nobody is looking.
# Vercel Cron sends it as a bearer token; see app/console/vercel.json.
#   openssl rand -hex 32
CRON_SECRET=

# Google Data Portability is requested on the same Google sign-in, with its own
# scopes. It is the only sanctioned route to what someone orders and watches —
# food delivery, e-commerce and YouTube history are otherwise closed to third
# parties. Restricted scopes, so a public deployment needs Google verification.
